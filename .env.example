# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the Supabase admin client for Storage signed URL work if needed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only. Never exposed to the client. Used by app/api/claude/* routes.
ANTHROPIC_API_KEY=sk-ant-...

# Server-only. Used by the Deal Finder feature (lib/rentcast.ts) to search
# for-sale listings and pull comps/value estimates. Get a key at rentcast.io.
RENTCAST_API_KEY=your-rentcast-api-key

# Server-only. Optional — only needed for the Rooms tab's "Generate image (AI)"
# button (lib/openai.ts), which calls OpenAI's image API to render a room
# concept photo automatically instead of you pasting the prompt into ChatGPT
# by hand. Get a key at platform.openai.com. Without this set, the app still
# writes a concise image prompt you can copy elsewhere — it just won't
# generate the image itself.
OPENAI_API_KEY=sk-...
