# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the Supabase admin client for Storage signed URL work if needed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only, and only needed to run `npm run migrate` (scripts/migrate.mjs)
# instead of pasting each supabase/migrations/*.sql file into the Supabase
# SQL editor by hand. Get it from Supabase -> Project Settings -> Database ->
# Connection string ("URI"); use the DIRECT connection on port 5432, not the
# pgbouncer pooler on 6543. Never commit the real value — this is a full
# Postgres superuser-ish credential, not a scoped API key.
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project.supabase.co:5432/postgres

# Server-only. Never exposed to the client. Used by app/api/claude/* routes.
ANTHROPIC_API_KEY=sk-ant-...

# Server-only. Optional — only needed for the Rooms tab's "Generate image (AI)"
# button (lib/openai.ts), which calls OpenAI's image API to render a room
# concept photo automatically instead of you pasting the prompt into ChatGPT
# by hand. Get a key at platform.openai.com. Without this set, the app still
# writes a concise image prompt you can copy elsewhere — it just won't
# generate the image itself.
OPENAI_API_KEY=sk-...

# Server-only. Optional — only needed for the "Get alerts" button on each
# construction (lib/email.ts, lib/alerts.ts), which emails subscribers on
# chat messages, checklist/warranty item updates, and warranty status
# changes. Get a key at resend.com — the free tier is 3,000 emails/month.
# Without this set, subscribing still works but no email actually sends
# (the failure is logged, not shown to the user — see lib/alerts.ts).
RESEND_API_KEY=re_...

# Server-only. Optional — the "from" address alert emails are sent from.
# Defaults to Resend's shared "onboarding@resend.dev", which only delivers
# to the account owner's own verified email — fine for testing this
# yourself, not for real subscribers. Verify a domain in Resend's dashboard
# and set this to an address on it (e.g. alerts@yourdomain.com) before
# relying on this for anyone else.
ALERT_FROM_EMAIL=alerts@yourdomain.com
